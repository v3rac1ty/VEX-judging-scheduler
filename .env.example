# VEX Judging Scheduler configuration.
#
# Copy this file to `.env` (same folder, never committed) and uncomment what you need.
# Format: KEY=VALUE per line; `#` starts a comment; quotes and an `export ` prefix are allowed.
# A variable already set in the real environment wins over this file.

# IANA timezone of the event, e.g. America/Chicago. Default: this computer's timezone.
# EVENT_TZ=America/Chicago

# Interface and port for `python -m judging`.
# Default host 0.0.0.0 serves every device on the LAN; 127.0.0.1 keeps it on this computer.
# JUDGING_HOST=0.0.0.0
# JUDGING_PORT=8000

# Where state.json, draft.json, schedules/, admin_pin.txt and session_key live.
# Default: <repo>/data. Use a dedicated folder: reset deletes stray *.json files in it.
# JUDGING_DATA_DIR=/path/to/practice-data

# PIN that unlocks the admin controls (generate, print, reset, setup): 4-12 digits, numbers
# only (phones show a numeric keypad). Leave unset to have a random 6-digit PIN generated
# once, saved in <data dir>/admin_pin.txt and shown when the server starts.
# JUDGING_ADMIN_PIN=482913

# --- Tournament Manager API (optional) ---
# Lets the admin pull the match list straight from TM ("Fetch from TM" / "Auto-update")
# instead of dropping a file. TM is used only when URL, client id, client secret and API
# key are ALL set; otherwise the app runs on file uploads alone. Read-only public API:
# the app only ever GETs /api/matches/<division>.
#
# Enable the API in TM first: Tools > Options > Web Publishing. Getting a token needs
# internet access (auth.vextm.dwabtech.com); TM itself is reached over the event LAN.
# The client secret and API key stay on this computer: they are never logged, shown in
# the banner or sent to any browser. Never commit your real .env.

# TM web server address (the TM laptop's IP, plus :port if it isn't 80).
# JUDGING_TM_URL=http://192.168.1.50:8080

# Credentials issued for the TM public API.
# JUDGING_TM_CLIENT_ID=your-client-id
# JUDGING_TM_CLIENT_SECRET=your-client-secret

# The event's TM API key (signs every request).
# JUDGING_TM_API_KEY=your-api-key

# Division whose matches are read. Default: 1.
# JUDGING_TM_DIVISION=1

# Auto-update interval in seconds. Minimum and default 60 (TM asks for at most one
# request per minute per resource); a lower value stops the server at startup.
# JUDGING_TM_POLL_SECONDS=60

# Token endpoint. Only change this to point at a mock server for testing.
# JUDGING_TM_AUTH_URL=https://auth.vextm.dwabtech.com/oauth2/token
