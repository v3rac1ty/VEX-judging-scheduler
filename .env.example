# VEX Judging Scheduler configuration.
#
# Copy this file to `.env` (same folder, never committed) and uncomment what you need.
# Format: KEY=VALUE per line; `#` starts a comment; quotes and an `export ` prefix are allowed.
# A variable already set in the real environment wins over this file.

# IANA timezone of the event, e.g. America/Chicago. Default: this computer's timezone.
# EVENT_TZ=America/Chicago

# Interface and port for `python -m judging`.
# Default host 0.0.0.0 serves every device on the LAN; 127.0.0.1 keeps it on this computer.
# JUDGING_HOST=0.0.0.0
# JUDGING_PORT=8000

# Where state.json, draft.json, schedules/, admin_pin.txt and session_key live.
# Default: <repo>/data. Use a dedicated folder: reset deletes stray *.json files in it.
# JUDGING_DATA_DIR=/path/to/practice-data

# PIN that unlocks the admin controls (generate, print, reset, setup): 4-12 digits, numbers
# only (phones show a numeric keypad). Leave unset to have a random 6-digit PIN generated
# once, saved in <data dir>/admin_pin.txt and shown when the server starts.
# JUDGING_ADMIN_PIN=482913

# --- TM API (Phase 4) ---
# Tournament Manager API settings will be documented here.
